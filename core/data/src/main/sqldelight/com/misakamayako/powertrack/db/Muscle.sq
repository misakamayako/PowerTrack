-- §2.4 / §3.1：肌肉是两层树，id 用固定 slug（便于 seed 幂等和代码引用）
CREATE TABLE muscle (
    id           TEXT NOT NULL PRIMARY KEY,
    parent_id    TEXT REFERENCES muscle(id) ON DELETE RESTRICT,
    name         TEXT NOT NULL,
    name_en      TEXT,
    region       TEXT,
    depth        INTEGER NOT NULL DEFAULT 0,
    order_index  INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX idx_muscle_parent ON muscle(parent_id, order_index);

selectAll:
SELECT * FROM muscle ORDER BY depth, order_index, name;

selectById:
SELECT * FROM muscle WHERE id = ?;

selectChildren:
SELECT * FROM muscle WHERE parent_id = ? ORDER BY order_index;

insert:
INSERT OR IGNORE INTO muscle(id, parent_id, name, name_en, region, depth, order_index)
VALUES (?, ?, ?, ?, ?, ?, ?);

update:
UPDATE muscle SET parent_id = ?, name = ?, name_en = ?, region = ?, depth = ?, order_index = ?
WHERE id = ?;

count:
SELECT COUNT(*) FROM muscle;
